# Parcial - ejercicio 6 - cola e up next

from ejercicio_04 import ListaEnlazada


# Excepción propia de este ejercicio
class ColaVaciaError(Exception):
    pass


class Cola():
    """Cola sobre ListaEnlazada. El frente es el primer nodo."""

    def __init__(self):
        self.items = ListaEnlazada()

    def encolar(self, dato):
        self.items.insertar_al_final(dato)

    def desencolar(self):
        """Saca y devuelve el primero. Si está vacía levanta ColaVaciaError."""
        if self.items.esta_vacia():
            raise ColaVaciaError("No se puede desencolar: la cola está vacía.")
        return self.items.quitar_primero()

    def ver_frente(self):
        """Devuelve el primero y lo deja en la cola.
           Si está vacía levanta ColaVaciaError."""
        if self.items.esta_vacia():
            raise ColaVaciaError("No hay frente: la cola está vacía.")
        return self.items.prim.dato

    def esta_vacia(self):
        return self.items.esta_vacia()


class ColaReproduccion():
    """La cola 'up next'. Usa una Cola de canciones."""

    def __init__(self):
        self.cola = Cola()

    def encolar_cancion(self, cancion):
        self.cola.encolar(cancion)

    def siguiente(self):
        """Devuelve la canción que toca ahora (y la saca de la cola)."""
        return self.cola.desencolar()

    def que_sigue(self):
        """Devuelve la canción del frente, sin sacarla."""
        return self.cola.ver_frente()


