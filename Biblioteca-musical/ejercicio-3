# Parcial - ejercicio 3 - versiones

def versiones_de(biblioteca, versiones, cancion_id):
    """Lista de (titulo, tipo) de todo lo derivado, sin incluir la canción original.
       Pre: versiones es una lista de tuplas (cancion_id, version_de_id, tipo).
       Levanta CancionNoEncontradaError si cancion_id no está en la biblioteca."""

    #si la canción no existe, obtener levanta la excepción.
    biblioteca.obtener(cancion_id)

    #versiones directas de esta canción: (id de la versión, tipo)
    directas = []
    for v in versiones:
        if v[1] == cancion_id:
            directas.append((v[0], v[2]))

    #caso base: nadie es versión de esta canción.
    if len(directas) == 0:
        return []

    #de menor a mayor cancion_id.
    directas.sort()

    resultado = []
    for version_id, tipo in directas:
        #primero la versión directa...
        resultado.append((biblioteca.obtener(version_id).titulo, tipo))
        #...después lo que cuelga de ella (llamada recursiva).
        resultado = resultado + versiones_de(biblioteca, versiones, version_id)
    return resultado


