class LibroRecetas:
    def:__init__(self) -> None:
        self._recetas: dict[str, Receta] = {}

    def: agregar_receta(self, receta: Receta) -> None:
        clave = receta.receta_id.strip().lower()
        self._recetas[clave] = receta

    def: obtener_receta(self, receta_id: str) -> Receta:
        clave = receta_id.strip().lower()
        if clave not in self._recetas:
            raise RecetaNoEncontrada(receta_id)
        return self._recetas[clave]

def: ingredientes_totales(
    receta_id: str,
    libro: LibroRecetas,
    subrecetas: dict[str, list[str]],
    ingredientes: dict[str, list[ItemMedida]],-> list[tuple[str, str, float, str]]: (Devuelve una lista de tuplas (receta_id, nombre, cantidad, unidad).
    Orden):
      1. Primero los ítems propios de la receta principal (ingredientes, carne, aceite,
         cocción, perejil, cebolla, morrón rojo, salsa picante, etc.).
      2. Luego cada subreceta en orden (ej. salsa_criolla y sofrito), incluyendo sus
         ingredientes, salsas, litros de agua, gramos de salsa, vegetales o carnes.
    def:receta_principal = libro.obtener_receta(receta_id)
    def: clave_principal = receta_principal.receta_id.strip().lower()
  resultado: list[tuple[str, str, float, str]] = []

    # 1. Ítems propios de la receta principal
    items_principales = ingredientes.get(clave_principal, receta_principal.items_propios)
    for item in items_principales:
        resultado.append(item.a_tupla(receta_principal.receta_id))

    # 2. Subrecetas asociadas en orden
    ids_subrecetas = subrecetas.get(clave_principal, receta_principal.subrecetas_ids)
    for sub_id in ids_subrecetas:
        sub_receta = libro.obtener_receta(sub_id)
        clave_sub = sub_receta.receta_id.strip().lower()
        items_sub = ingredientes.get(clave_sub, sub_receta.items_propios)

        for item in items_sub:
            resultado.append(item.a_tupla(sub_receta.receta_id))

        # Si una subreceta tuviera subrecetas anidadas, las recorre en orden
        for sub_anidada_id in subrecetas.get(clave_sub, sub_receta.subrecetas_ids):
            sub_anidada = libro.obtener_receta(sub_anidada_id)
            clave_anidada = sub_anidada.receta_id.strip().lower()
            for item in ingredientes.get(clave_anidada, sub_anidada.items_propios):
                resultado.append(item.a_tupla(sub_anidada.receta_id))
            return resultado


