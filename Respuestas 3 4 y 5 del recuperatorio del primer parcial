    def:agregar_al_final(self, dia: str, receta: EntradaMenu) -> None:
        nuevo_nodo = Nodo(dia=dia, receta=receta)
        if: self.cabeza is None:
            self.cabeza = nuevo_nodo
            self.cola = nuevo_nodo
        else:
            assert self.cola is not None
            self.cola.siguiente = nuevo_nodo
            self.cola = nuevo_nodo
        self._tamanio += 1

    def:quitar_por_dia(self, dia: str) -> bool:
        clave = dia.strip().lower()
        actual = self.cabeza
        anterior: Nodo | None = None

        while: actual is not None:
            if: actual.dia.strip().lower() == clave:
                if: anterior is None:
                    self.cabeza = actual.siguiente
                else:
                    anterior.siguiente = actual.siguiente
                if: actual is self.cola:
                    self.cola = anterior
                self._tamanio -= 1
                return True
            anterior = actual
            actual = actual.siguiente
        return False

    def:contiene_dia(self, dia: str) -> bool:
        clave = dia.strip().lower()
        actual = self.cabeza
        while: actual is not None:
            if: actual.dia.strip().lower() == clave:
                return True
            actual = actual.siguiente
        return False
    def:__iter__(self) -> IteradorListaEnlazada:
        return IteradorListaEnlazada(self.cabeza)
    def:__len__(self) -> int:
        return self._tamanio


