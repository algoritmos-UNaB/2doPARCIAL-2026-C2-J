#class Pila:"Estructura LIFO (último en entrar, primero en salir) apoyada en ListaEnlazada."
    def:__init__(self) -> None:
        self._elementos = ListaEnlazada()
    def: apilar(self, dato: Any) -> None:
        self._elementos.insertar_al_frente(dato)
    def: desapilar(self) -> Any:
        return self:_elementos.quitar_del_frente()

    def: ver_tope(self) -> Any:
        return self:_elementos.ver_frente()

