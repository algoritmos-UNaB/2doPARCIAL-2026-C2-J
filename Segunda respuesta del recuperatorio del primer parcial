#class Receta:
    nombre: str
    tiempo_minutos: int
    ingredientes: list[Ingrediente] = field(default_factory=list)
    salsas_necesarias: list[str] = field(default_factory=list)
    carnes_necesarias: list[dict[str, float | str]] = field(default_factory=list)
    metodos_preparacion: list[str] = field(default_factory=list)

    def peso_total_gramos(self) -> float:
        total_ingredientes = sum(ing.gramos for ing in self.ingredientes)
        total_carnes = sum(float(carne.get("gramos", 0.0)) for carne in self.carnes_necesarias)
        return total_ingredientes + total_carnes

    def mostrar_detalle(self) -> None:
        print(f"=== {self.nombre.upper()} ===")
        print(f"Tiempo necesario: {self.tiempo_minutos} minutos")

        print("Ingredientes (en gramos):")
        for ing in self.ingredientes:
            print(f"  - {ing}")

        if self.salsas_necesarias:
            print("Salsas necesarias:", ", ".join(self.salsas_necesarias))
        else:
            print("Salsas necesarias: Ninguna")

        if self.carnes_necesarias:
            print("Carnes necesarias (en gramos):")
            for carne in self.carnes_necesarias:
                print(f"  - {carne['corte']}: {carne['gramos']} g")
        else:
            print("Carnes necesarias: Ninguna")

        print("Métodos de preparación:")
        for i, paso in enumerate(self.metodos_preparacion, start=1):
            print(f"  {i}. {paso}")

        print(f"Peso total registrado: {self.peso_total_gramos()} g\n")


class LibroRecetas:
    def __init__(self) -> None:
        self._recetas: dict[str, Receta] = {}

    def agregar_receta(self, receta: Receta) -> None:
        clave = receta.nombre.strip().lower()
        self._recetas[clave] = receta

    def obtener_receta(self, nombre: str) -> Receta:
        clave = nombre.strip().lower()
        if clave not in self._recetas:
            raise RecetaNoEncontrada(nombre)
        return self._recetas[clave]

    def listar_recetas(self) -> list[str]:
        return [receta.nombre for receta in self._recetas.values()]

    def mostrar_todas(self) -> None:
        for receta in self._recetas.values():
            receta.mostrar_detalle()


